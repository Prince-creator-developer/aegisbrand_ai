{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**",
          "data/**",
          "core/**",
          "app.py",
          "AegisBrand_AI_CodeStar30_Round3_Final_Finish_Dossier.pdf",
          "Raven_Intelligence_CodeTitans2026_Round1_Plan.pdf"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
